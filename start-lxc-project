#!/bin/bash

# ==============================================================================
# LXC Project Starter
# ==============================================================================
#
# SETUP INSTRUCTIONS: (See create-lxc-project for full details)
# Required Sudoers:
# echo "%lxc-users ALL=(ALL) NOPASSWD: /usr/local/bin/create-lxc-project, /usr/local/bin/remove-lxc-project, /usr/local/bin/list-lxc-projects, /usr/local/bin/start-lxc-project, /usr/local/bin/stop-lxc-project" | sudo tee /etc/sudoers.d/lxc-automation
#
# This script starts an unprivileged container for the caller.
# If run as root, it can start any container by searching all tiers.
# ==============================================================================

# Exit on error
set -e

# Help function
show_help() {
    cat <<EOF
Usage: $(basename "$0") <container_name>

Starts an LXC container.
- Regular users: Starts containers in their own unprivileged path.
- Root user: Searches privileged and then all user paths for the container.
EOF
}

# Check for help flags
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    show_help
    exit 0
fi

# ------------------------------------------------------------------------------
# AUTO-SUDO LOGIC
# ------------------------------------------------------------------------------
if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi

CURRENT_USER="${SUDO_USER:-$(whoami)}"
CONTAINER_NAME=$1

if [ -z "$CONTAINER_NAME" ]; then
    show_help
    exit 1
fi

# Security check: User must be in lxc-users group (unless root)
if [ "$CURRENT_USER" != "root" ] && ! groups "$CURRENT_USER" | grep -q "\blxc-users\b"; then
    echo "Error: User '$CURRENT_USER' is not a member of the 'lxc-users' group."
    exit 1
fi
# ------------------------------------------------------------------------------

# Load optional configuration files (in order of precedence)
for conf in "/etc/lxc-tools/lxc-tools.conf" "$HOME/.config/lxc-tools/lxc-tools.conf" "./lxc-tools.conf"; do
    if [ -f "$conf" ]; then
        # shellcheck source=/dev/null
        . "$conf"
    fi
done

# Apply safe defaults if not defined in config or environment
LXC_ZFS_POOL="${LXC_ZFS_POOL:-rpool}"
LXC_PRIV_PATH="${LXC_PRIV_PATH:-/${LXC_ZFS_POOL}/lxc/privileged}"
LXC_UNPRIV_BASE="${LXC_UNPRIV_BASE:-/${LXC_ZFS_POOL}/lxc/unprivileged}"

find_container_path() {
    local name=$1
    # 1. Check privileged
    if [ -d "$LXC_PRIV_PATH/$name" ]; then
        echo "$LXC_PRIV_PATH"
        return 0
    fi
    # 2. Check all user dirs
    for d in "$LXC_UNPRIV_BASE"/*; do
        if [ -d "$d/$name" ]; then
            echo "$d"
            return 0
        fi
    done
    return 1
}

if [ "$CURRENT_USER" = "root" ]; then
    PATH_FOUND=$(find_container_path "$CONTAINER_NAME")
    if [ $? -eq 0 ]; then
        echo "Starting container '$CONTAINER_NAME' in path: $PATH_FOUND"
        lxc-start -n "$CONTAINER_NAME" -P "$PATH_FOUND"
    else
        echo "Error: Container '$CONTAINER_NAME' not found in any path."
        exit 1
    fi
else
    # For regular users, strictly limit to their own path
    LXC_PATH="$LXC_UNPRIV_BASE/$CURRENT_USER"
    if [ -d "$LXC_PATH/$CONTAINER_NAME" ]; then
        echo "Starting container '$CONTAINER_NAME' as user $CURRENT_USER..."
        sudo -u "$CURRENT_USER" lxc-start -n "$CONTAINER_NAME" -P "$LXC_PATH"
    else
        echo "Error: Container '$CONTAINER_NAME' not found in $LXC_PATH."
        exit 1
    fi
fi

# Verify start and show connection info
FINAL_PATH="${PATH_FOUND:-$LXC_PATH}"
echo "-------------------------------------------------------"
lxc-info -n "$CONTAINER_NAME" -P "$FINAL_PATH"
echo "-------------------------------------------------------"
echo "Container '$CONTAINER_NAME' is active."
echo ""
echo "To connect (Root Shell):"
echo "  lxc-attach -n $CONTAINER_NAME -P $FINAL_PATH"
echo ""
echo "To connect (Console):"
echo "  lxc-console -n $CONTAINER_NAME -P $FINAL_PATH"
echo "-------------------------------------------------------"
