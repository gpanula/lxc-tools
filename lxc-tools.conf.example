# LXC Tools Configuration (INI)
# Copy this file to one of the following locations and customize for your environment:
#   /etc/lxc-tools/lxc-tools.conf       (system-wide, requires root)
#   ~/.config/lxc-tools/lxc-tools.conf  (user-specific)
#   ./lxc-tools.conf                    (current directory, for testing)
#
# Environment variables take precedence over config file values:
#   LXC_ZFS_POOL, LXC_PRIV_PATH, LXC_UNPRIV_BASE, BASE_PROJECT_DIR, LXC_NET_LINK
# If neither is set, safe defaults are used.

[zfs]
# Name of the ZFS pool where LXC datasets will be created.
# Default: rpool
pool = rpool

# Path to privileged (system-managed) LXC containers.
# When omitted, defaults to /<pool>/lxc/privileged
# priv_path = /rpool/lxc/privileged

# Base path for unprivileged (user-managed) LXC containers.
# When omitted, defaults to /<pool>/lxc/unprivileged
# unpriv_base = /rpool/lxc/unprivileged

[paths]
# Host directory where project files are bind-mounted into containers.
# Default: /opt/project
project_dir = /opt/project

[network]
# Default network bridge or interface for container veth links.
# Common values: lxcbr0 (default LXC bridge), br0, virbr0, or custom bridge name.
# Default: lxcbr0
bridge = lxcbr0
